# CI 専用の非シークレット環境変数（ci-standard が build / e2e ジョブで読み込む）
#
# CI には Turso の実DBもローカルSQLiteファイルも存在しない。
# lib/db/client.ts と drizzle.config.ts のフォールバックは file:.data/local.db だが、
# .data/ は .gitignore 済みでチェックアウト直後には存在せず、
# libSQL が SQLITE_CANTOPEN(14) を返して next build / drizzle-kit migrate が落ちる。
# ci.yml.bak（ci-standard 移行前の自前CI）では Build ステップに同じ値を渡していた。
TURSO_DATABASE_URL=file::memory:
